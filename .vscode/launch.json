{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (ST-Link via OpenOCD)",
            "type": "gdb",
            "request": "launch",
            "program": "${workspaceFolder}/build/stm32_hello.elf",
            "cwd": "${workspaceFolder}",
            "setupCommands": [
                {
                    "description": "Enable ARM hardware watchpoints",
                    "text": "hwdpus",
                    "ignoreFailures": true
                }
            ],
            "MIMode": "gdb",
            "miDebuggerServer": "localhost:3333",
            "miDebuggerPath": "E:/arm-gnu-toolchain-15.3.rel2-mingw-w64-i686-arm-none-eabi/bin/arm-none-eabi-gdb.exe",
            "preLaunchTask": "openocd-session",
            "internalConsoleOptions": "openOnSessionStart"
        }
    ]
}
